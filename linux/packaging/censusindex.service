[Unit]
Description=CensusIndex index API (read-only)
Documentation=https://github.com/luciomerlo/CensusIndex
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/censusindex serve --port 8787
Restart=on-failure
RestartSec=3
# El índice se genera con `censusindex index`; el servicio sólo lo sirve.
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=default.target
