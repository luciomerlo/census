<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.luciomerlo.censusindex.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/censusindex</string>
    <string>serve</string>
    <string>--no-watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/censusindex-serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/censusindex-serve.err.log</string>
</dict>
</plist>
